# -----------------------------------------------------------------------------
# SchemaFlow Environment Configuration
# -----------------------------------------------------------------------------

# PORT: The port SchemaFlow Express + Vite server listens on (default: 3000)
PORT=3000

# NODE_ENV: 'development' for Vite HMR server, 'production' for compiled assets
NODE_ENV=development

# GEMINI_API_KEY: Google Gemini API key required for AI Schema Architect (/api/generate-schema)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Optional canonical URL for deployments and self-referential links
APP_URL=http://localhost:3000
