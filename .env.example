# -----------------------------------------------------------------------------
# SchemaFlow Environment Configuration
# -----------------------------------------------------------------------------

# PORT: The port SchemaFlow Express + Vite server listens on (default: 3000)
PORT=3000

# NODE_ENV: 'development' for Vite HMR server, 'production' for compiled assets
NODE_ENV=development

# GEMINI_API_KEY: Google Gemini API key required for AI Schema Architect (/api/generate-schema)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL: Optional model override for the AI Schema Architect (default: gemini-2.5-flash).
# Change this if Google retires the default model.
GEMINI_MODEL=gemini-2.5-flash

# GEMINI_FALLBACK_MODEL: Second model tried when GEMINI_MODEL is overloaded (503) or hangs.
# Defaults to gemini-2.0-flash. Set it to an empty value to only retry the primary model.
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# APP_URL: Optional canonical URL for deployments and self-referential links
APP_URL=http://localhost:3000

# LOG_MEM_STATS: Set to 'true' to log process memory stats (RSS, heap, arrayBuffers in MB) every 15s
LOG_MEM_STATS=false
